# ASM Pipeline Configuration
# Copy to .env and customize. NEVER commit .env to git.

# Redis Streams (Remote Server)
ASM_REDIS_HOST=192.168.1.21
ASM_REDIS_PORT=6379
ASM_REDIS_PASSWORD=changeme
ASM_REDIS_DB=0

# ClickHouse (Remote Server)
ASM_CH_URL=http://192.168.1.21:8123
ASM_CH_USER=asm_ingestor
ASM_CH_PASSWORD=changeme
ASM_CH_DATABASE=asm_pipeline

# Producer Identity
ASM_PRODUCER_HOST=laptop-001

# Stream & Ingestion Tuning
ASM_MAX_STREAM_LEN=1000000
ASM_BATCH_SIZE=5000
ASM_FLUSH_INTERVAL=5.0

# Safety Limits
ASM_MAX_EVENTS_PER_SCAN=500000

# Logging
ASM_LOG_LEVEL=INFO
